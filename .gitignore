# ============================================================
#  大创 —— 遥操作系统   .gitignore
#  本仓库只托管源码；本地大型依赖 / 模型资产不入库（详见 README）
# ============================================================

# ---------- Python 缓存 / 编译产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo

# ---------- 本地依赖目录（约 335 MB）----------
# 由 pip install -r requirements.txt 生成，不入库
lib/

# ---------- 第三方 SDK（约 1013 MB）----------
# 来源：https://gitee.com/ericbrunt/linkerhand_telop_python
# 获取方式见 README「六、模型资产获取」
linkerhand_sdk/

# ---------- 机器人模型资产 ----------
# 只放行代码实际使用的 from_teleopbench（★ 已入库，用普通 Git 管理，未用 LFS）
# 其余子目录（arms/ assembly/ h1_paper/ h1_with_hand/ hands/ linker_hand/ xarm7_ability/）
# 代码未引用，不入库（共约 274 MB）
#
# 注意：不能用 `robots/` 整体排除 —— gitignore 规定「父目录被排除后
#       无法再重新包含其子文件」，必须用 `robots/*` + `!robots/xxx/`
robots/*
!robots/from_teleopbench/

# ---------- 运行产物 / 采集数据 ----------
data/
outputs/
logs/

# 脚本调试时重定向的临时日志（可能被运行中的进程占用，删不掉）
_*.log

# ---------- 临时实验目录 ----------
# 一次性试验（绘图、抓图、试脚本）产生的目录，例如 tmp_bingdwendwen/
# 这类目录不属于仿真平台本体，不入库
tmp_*/

# 数据文件：默认排除（避免误提交体积大的运行产物）
*.h5
*.hdf5
*.pkl
*.npz
*.mp4
*.avi

# ★ 但 datasets/ 下的数据必须放行 ★
#   契约 G（human_hand.h5）与契约 H（actions.h5）靠 Git 交换，
#   若被 *.h5 排除掉，「用 Git 交换数据」的流程会直接失效！
#   （gitignore 规则：父目录未被排除时，可用 ! 重新包含子文件）
!datasets/**/*.h5
!datasets/**/*.hdf5
!datasets/**/*.npz

# ---------- 模型权重 ----------
*.pt
*.pth
*.ckpt
*.onnx

# ---------- 系统文件 ----------
Thumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/
