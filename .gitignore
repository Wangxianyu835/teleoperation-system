# ============================================================
#  大创 —— 遥操作系统   .gitignore
#  本仓库只托管源码；本地大型依赖 / 模型资产不入库（详见 README）
# ============================================================

# ---------- Python 缓存 / 编译产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo

# ---------- 本地依赖目录（约 335 MB）----------
# 由 pip install -r requirements.txt 生成，不入库
lib/

# ---------- 第三方 SDK（约 1013 MB）----------
# 来源：https://gitee.com/ericbrunt/linkerhand_telop_python
# 获取方式见 README「六、模型资产获取」
linkerhand_sdk/

# ---------- 机器人模型资产 ----------
# 正式资源位于 assets/robots，随仓库管理；旧本地资源目录不入库。
/robots/

# ---------- 运行产物 / 采集数据 ----------
/data/
outputs/
logs/

# 脚本调试时重定向的临时日志（可能被运行中的进程占用，删不掉）
_*.log

# 数据文件：默认排除（避免误提交体积大的运行产物）
*.h5
*.hdf5
*.pkl
*.npz
*.mp4
*.avi

# 阶段汇报视频是交付素材，允许随 present 成果包入库
!present/videos/*.mp4
present/*.log
present/qa/

# ★ 但 datasets/ 下的数据必须放行 ★
#   契约 G（human_hand.h5）与契约 H（actions.h5）靠 Git 交换，
#   若被 *.h5 排除掉，「用 Git 交换数据」的流程会直接失效！
#   （gitignore 规则：父目录未被排除时，可用 ! 重新包含子文件）
!datasets/**/*.h5
!datasets/**/*.hdf5
!datasets/**/*.npz

# ---------- 模型权重 ----------
*.pt
*.pth
*.ckpt
*.onnx
hand_landmarker.task
pose_landmarker_lite.task
pose_landmarker_full.task

# ---------- 系统文件 ----------
Thumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# Persistence package contains source code, not runtime datasets.
!src/teleoperation/data/
