# ============================================================
#  大创 —— 遥操作系统   .gitignore
#  本仓库只托管源码；本地大型依赖 / 模型资产不入库（详见 README）
# ============================================================

# ---------- Python 缓存 / 编译产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo

# ---------- 本地依赖目录（约 335 MB）----------
# 由 pip install -r requirements.txt 生成，不入库
lib/

# ---------- 第三方 SDK（约 1013 MB）----------
# 来源：https://gitee.com/ericbrunt/linkerhand_telop_python
# 获取方式见 README「六、模型资产获取」
linkerhand_sdk/

# ---------- 机器人模型资产 ----------
# 只放行代码实际使用的 from_teleopbench（★ 已入库，用普通 Git 管理，未用 LFS）
# 其余子目录（arms/ assembly/ h1_paper/ h1_with_hand/ hands/ linker_hand/ xarm7_ability/）
# 代码未引用，不入库（共约 274 MB）
#
# 注意：不能用 `robots/` 整体排除 —— gitignore 规定「父目录被排除后
#       无法再重新包含其子文件」，必须用 `robots/*` + `!robots/xxx/`
robots/*
!robots/from_teleopbench/

# ---------- 运行产物 / 采集数据 ----------
data/
outputs/
logs/
*.h5
*.hdf5
*.pkl
*.npz
*.mp4
*.avi

# ---------- 模型权重 ----------
*.pt
*.pth
*.ckpt
*.onnx

# ---------- 系统文件 ----------
Thumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/
